@model ProductFormViewModel
@{
    var action = ViewData["Action"]?.ToString() ?? "Create";
    var formTitle = ViewData["FormTitle"]?.ToString() ?? "Товар";
}

<section class="form-panel">
    <div class="form-heading">
        <h1>@formTitle</h1>
        <a class="btn btn-outline-dark" asp-controller="Product" asp-action="Index">Назад</a>
    </div>

    <form asp-controller="Product" asp-action="@action" method="post" enctype="multipart/form-data" class="product-form">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CurrentImageName" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label">Назва</label>
                <input asp-for="Name" class="form-control" placeholder="Наприклад, Ноутбук Acer Swift 14" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Category" class="form-label">Категорія</label>
                <input asp-for="Category" class="form-control" placeholder="Ноутбуки" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Price" class="form-label">Ціна</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Rating" class="form-label">Рейтинг</label>
                <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label">Amount (к-сть в наявності)</label>
                <input asp-for="Amount" class="form-control" type="number" min="0" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Опис</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-7">
                <label asp-for="Image" class="form-label">Зображення</label>
                <input asp-for="Image" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <div class="current-image">
                    @if (string.IsNullOrWhiteSpace(Model.CurrentImageName))
                    {
                        <span>Зображення не вибрано</span>
                    }
                    else
                    {
                        <img src="~/images/products/@Model.CurrentImageName" alt="@Model.Name" />
                    }
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-success" type="submit">Зберегти</button>
            <a class="btn btn-outline-dark" asp-controller="Product" asp-action="Index">Скасувати</a>
        </div>
    </form>
</section>
