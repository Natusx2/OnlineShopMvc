@model ProductListViewModel
@{
    ViewData["Title"] = "Товари";
}

<section class="admin-heading">
    <div>
        <p>Адмін-панель</p>
        <h1>Товари</h1>
    </div>
    <a class="btn btn-success" asp-controller="Product" asp-action="Create">Додати товар</a>
</section>

<section class="shop-toolbar">
    <div>
        <h2>Список товарів</h2>
        <span>@Model.Products.Count позицій</span>
    </div>
    <form asp-controller="Product" asp-action="Index" method="get" class="sort-form">
        <label for="sort">Сортування</label>
        <select id="sort" name="sort" class="form-select" onchange="this.form.submit()">
            <option value="@ProductSortOptions.PriceAsc" selected="@(Model.Sort == ProductSortOptions.PriceAsc)">Ціна: зростання</option>
            <option value="@ProductSortOptions.PriceDesc" selected="@(Model.Sort == ProductSortOptions.PriceDesc)">Ціна: спадання</option>
            <option value="@ProductSortOptions.Name" selected="@(Model.Sort == ProductSortOptions.Name)">Назва</option>
            <option value="@ProductSortOptions.RatingDesc" selected="@(Model.Sort == ProductSortOptions.RatingDesc)">Рейтинг</option>
        </select>
    </form>
</section>

<div class="table-responsive admin-table-wrap">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Назва</th>
                <th>Категорія</th>
                <th>Ціна</th>
                <th>Рейтинг</th>
                <th>К-сть</th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr class="@(product.Amount == 0 ? "table-secondary" : "")">
                    <td>
                        <div class="admin-product-cell">
                            @if (string.IsNullOrWhiteSpace(product.ImageName))
                            {
                                <span class="mini-placeholder">@product.Name[..1]</span>
                            }
                            else
                            {
                                <img src="~/images/products/@product.ImageName" alt="@product.Name" />
                            }
                            <strong>@product.Name</strong>
                        </div>
                    </td>
                    <td>@product.Category</td>
                    <td>@product.Price.ToString("N0") грн</td>
                    <td>@product.Rating.ToString("0.0")</td>
                    <td>@product.Amount</td>
                    <td class="text-end">
                        <a class="btn btn-outline-dark btn-sm" asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id">Редагувати</a>
                        <form class="d-inline" asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" method="post">
                            <button class="btn btn-outline-danger btn-sm" type="submit">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
